{
	"geode": "5.10.1",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"id": "ezkidtrix.attempt-labeler",
	"name": "Attempt Labeler",
	"version": "v1.0.7",
	"developer": "Ezkidtrix",
	"description": "places a fun label where you last died",
	"dependencies": {
		"geode.node-ids": ">=v1.23.3"
	},
	"tags": ["content", "customization", "gameplay", "enhancement", "joke"],
	"links": {
		"source": "https://github.com/Ezkidtrix/attempt-labeler"
	},
	"settings": {
		"enabled": {
			"type": "bool",
			"name": "Enable Mod",
			"default": true
		},
		"max-labels": {
			"type": "int",
			"name": "Max Labels",
			"description": "the maximum number of labels that can be displayed at once.",
			"default": 10,
			"min": 1,
			"max": 100
		},
		"text-color": {
			"type": "rgb",
			"name": "Text Color",
			"default": "#ffffff",
			"enable-if": "enabled"
		}
	}
}
